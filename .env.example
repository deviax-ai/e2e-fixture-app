# Example environment variables — Deviax should parse this file and
# propose these as env-var fields in the IssueCard it generates for
# the hardcoded-config issues.

# User-facing greeting (echoed by /env)
GREETING=hello

# Upstream API — replace with your deployment's API host
UPSTREAM_API_URL=http://localhost:4000/api

# Server listen port (Kubernetes injects its own; this is only for
# local `python app.py`)
PORT=8080

# Session secret — MUST be overridden in production (any 32+ random chars)
SESSION_SECRET=dev-secret-change-me-before-prod

# SQLite file path (switch to DATABASE_URL when using managed Postgres)
SQLITE_PATH=/tmp/counter.db
